# ===== LexContract / document 模块配置样例 =====
# 复制为 .env 并按需修改

# PostgreSQL 连接
# 本机默认 PostgreSQL 端口；如使用 ParadeDB 容器映射到其他端口，请修改 PG_PORT。
PG_HOST=localhost
PG_PORT=5432
PG_DB=lexcontract
PG_USER=postgres
PG_PASSWORD=postgres

# 文档解析输出目录（JSON）
OUTPUT_DIR=./output

# 切片参数
CHUNK_TOKEN_CAP=600        # 单个切片 token 上限
CHUNK_MIN_TOKENS=20

# embedding 模型
# 本地多语模型名（sentence-transformers），默认 BAAI/bge-m3 (1024 维)
EMBED_MODEL_NAME=BAAI/bge-m3
EMBED_DIM=1024
EMBED_DEVICE=cpu          # cpu / cuda
