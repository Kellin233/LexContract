# --- PostgreSQL（ParadeDB 发行版，内置 pg_search + pgvector；与 document 模块共用）---
# 本机本地验证：paradedb/paradedb:0.25.2-pg16 容器映射到 5434
PG_HOST=localhost
PG_PORT=5434
PG_DB=lexcontract
PG_USER=postgres
PG_PASSWORD=postgres

# --- embedding（复用 document 模块模型，维度须与库中 vector(1024) 一致）---
EMBED_MODEL_NAME=BAAI/bge-m3
EMBED_DIM=1024
EMBED_DEVICE=cpu

# --- 检索默认参数 ---
# 混合检索候选池倍率（limit*4，至少 100）
CANDIDATE_K=100
# 混合检索最终返回条数
TOP_K=10
# 加权 Reciprocal Rank Fusion 参数
RRF_K=60
VECTOR_WEIGHT=0.5
BM25_WEIGHT=0.5

# --- 重排（BGE cross-encoder）---
RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANK_TOP_K=10
RERANK_BATCH_SIZE=32
RERANK_MAX_LENGTH=512

# 若 HuggingFace 直连不可达，设置镜像端点
# HF_ENDPOINT=https://hf-mirror.com
